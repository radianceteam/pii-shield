# Copy to .env next to docker-compose.yml and fill in. All three secrets are required.
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Injected by nginx; clients never send it themselves.
PII_SHIELD_TOKEN=

# LiteLLM admin credential — mints and revokes client keys. Never give this out.
LITELLM_MASTER_KEY=sk-

POSTGRES_PASSWORD=

# Real provider credentials. They stay inside LiteLLM and are never seen by clients.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Languages compiled into the pii-shield image, space separated.
PII_SHIELD_LANGUAGES=ru en
SPACY_MODEL_SIZE=lg

# Language of the text being read.
PII_SHIELD_LANGUAGE=ru
# Language the stand-ins are drawn from. Leave empty to keep the source language.
PII_SHIELD_SURROGATE_LANGUAGE=de

PII_SHIELD_PORT=8099
PII_SHIELD_MEM_LIMIT=3g
