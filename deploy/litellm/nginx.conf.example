# TLS termination in front of pii-shield.
#
# Install as its own file — one site per file — rather than appending to the default
# server block:
#   /etc/nginx/sites-available/<your-host>  +  a symlink in sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Obtain the certificate with:
#   certbot --nginx -d <your-host>
# The DNS record must resolve to this server first, or the HTTP-01 challenge fails.

server {
    server_name pii.example.com;

    # This service holds raw PII in memory and is CPU-bound on every request, so both
    # limits are load-bearing rather than hygiene. 1 MB is generous for a prompt; the
    # shield's own language model refuses anything over a million characters anyway.
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8099;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The shield's own gate. Clients authenticate to LiteLLM with their virtual key
        # in Authorization; this header is added here so they never handle it, and so a
        # request that skips nginx cannot reach the shield.
        proxy_set_header X-Pii-Shield-Token "REPLACE_WITH_PII_SHIELD_TOKEN";

        # Authorization is forwarded untouched — it carries the client's LiteLLM key.
        proxy_pass_request_headers on;

        # Server-sent events: without these, nginx buffers the stream and the client
        # receives the whole answer at once, which defeats streaming.
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # A long generation legitimately takes minutes.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    listen 443 ssl;   # managed by Certbot
    # ssl_certificate     /etc/letsencrypt/live/<your-host>/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/<your-host>/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = pii.example.com) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    server_name pii.example.com;
    return 404;
}
