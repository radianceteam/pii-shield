# Copy to .env and edit. Required: PII_SHIELD_TOKEN.

# Shared secret for the sidecar's own endpoints (header: X-Pii-Shield-Token,
# or Authorization on the non-proxy routes). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PII_SHIELD_TOKEN=

# Languages compiled into the image, space separated (ru en ja ko zh ...).
PII_SHIELD_LANGUAGES=ru en
SPACY_MODEL_SIZE=lg

# Default language for detection at runtime.
PII_SHIELD_LANGUAGE=ru

# Leave empty to run anonymize/deanonymize only. Set to turn on the
# OpenAI-compatible proxy at /v1/chat/completions.
PII_SHIELD_UPSTREAM=
# Only used when the caller sends no Authorization header of its own.
PII_SHIELD_UPSTREAM_KEY=

PII_SHIELD_PORT=8099
# 1.1 GB resident with one language loaded, 1.6 GB with two (measured).
PII_SHIELD_MEM_LIMIT=3g
